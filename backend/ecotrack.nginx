server {
    listen 80;
    server_name your_domain.com; # ⚠️ CAMBIAR ESTO por tu dominio o IP pública

    location / {
        proxy_pass http://localhost:3001; # Asegúrate que tu backend corre en este puerto
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # Opcional: Configuración básica de seguridad
    # listen 443 ssl; # Descomentar cuando tengas SSL con certbot
}
